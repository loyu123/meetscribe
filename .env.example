# ============================================================
# MeetScribe 生产部署环境变量示例
# 用法：复制为 .env（与 docker-compose.yml 同目录），按需填写。
# docker compose 会自动读取同目录 .env 文件。
# ============================================================

# ---- AI 网关（纪要/问答/检索必需）----
# OpenAI 兼容端点；也可启动后在 Web「设置 → AI 服务」中配置（热生效）
ASR_GATEWAY_URL=
ASR_GATEWAY_TOKEN=

# ---- 安全（公网/办公网暴露前必配！）----
# API 鉴权：格式 "租户:密钥"，*: 为管理员。示例：
#   ASR_API_KEYS=me:s3cret1,*:admin-s3cret
ASR_API_KEYS=
# 媒体下载签名：启用后 /media 需带签名 token，防音频直链被转发滥用。随机长串即可：
#   ASR_MEDIA_SIGN_SECRET=$(openssl rand -hex 32)
ASR_MEDIA_SIGN_SECRET=

# ---- Webhook 回调 SSRF 防护 ----
# 默认拒绝回调本机/私网/云元数据地址。确需内网回调时二选一：
#   1) 精确放行域名（推荐）：ASR_WEBHOOK_ALLOWED_HOSTS=cb.internal.lan,hooks.example.com
#   2) 整体关闭校验（仅限完全可信内网）：ASR_WEBHOOK_ALLOW_PRIVATE=1
ASR_WEBHOOK_ALLOWED_HOSTS=
ASR_WEBHOOK_ALLOW_PRIVATE=0

# ---- 推理资源 ----
# 默认 ASR 后端：paraformer | sensevoice
ASR_BACKEND=paraformer
# 后台任务 worker 线程数（GPU 显存充足可加大）
ASR_WORKERS=1
